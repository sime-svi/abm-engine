# Credenciales de PostgreSQL / TimescaleDB.
# Copia este archivo a `.env` en esta misma carpeta y rellena los valores.
# ¡NUNCA subas el archivo .env real al repositorio!

POSTGRES_USER=abm
POSTGRES_PASSWORD=changeme
POSTGRES_DB=abm

# Puertos del host (docker-compose los usa para publicar los servicios y el motor para conectar).
# Se evitan los habituales (5432, 3000) porque suelen estar ocupados por otros proyectos.
PGPORT=25432
GRAFANA_PORT=23000

# El motor (con sink = "postgres"/"both") toma la conexión del entorno: usa estas variables
# POSTGRES_* + PGPORT (y PGHOST, localhost por defecto), o define DATABASE_URL para anularlas.
# Ejemplo:
# DATABASE_URL=postgres://abm:changeme@localhost:25432/abm
