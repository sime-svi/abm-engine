# Credenciales de PostgreSQL / TimescaleDB.
# Copia este archivo a `.env` en esta misma carpeta y rellena los valores.
# ¡NUNCA subas el archivo .env real al repositorio!

POSTGRES_USER=abm
POSTGRES_PASSWORD=changeme
POSTGRES_DB=abm

# El motor (con sink = "postgres"/"both") toma la conexión del entorno: usa estas variables
# POSTGRES_* (host=localhost:5432 por defecto), o define DATABASE_URL para anularlas. Ejemplo:
# DATABASE_URL=postgres://abm:changeme@localhost:5432/abm
