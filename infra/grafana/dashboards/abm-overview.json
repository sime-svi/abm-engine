          "refId": "A",
          "datasource": { "type": "postgres", "uid": "abm_timescaledb" },
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT tick, max(value) FILTER (WHERE metric_name = 'births') AS \"nacimientos\", max(value) FILTER (WHERE metric_name = 'deaths') AS \"muertes\" FROM metrics WHERE run_id = (SELECT run_id FROM simulation_runs ORDER BY started_at DESC LIMIT 1) GROUP BY tick ORDER BY tick"
