          "refId": "A",
          "datasource": { "type": "postgres", "uid": "abm_timescaledb" },
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT tick, value AS \"población\" FROM metrics WHERE metric_name = 'population' AND run_id = (SELECT run_id FROM simulation_runs ORDER BY started_at DESC LIMIT 1) ORDER BY tick"
        }
      ],
      "options": {
